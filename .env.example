# =================================================================
# AI Music Analyser - Environment Configuration Template
# =================================================================

# --- Application Runtime ---
APP_NAME=AI Music Analyser
APP_ENV=development
PORT=8080
DEBUG=false
PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python

# --- Security & JWT Authentication ---
# Generate a cryptographically secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-in-production-min-32-chars-secret-key-12345
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Database (PostgreSQL / SQLite) ---
# Development SQLite: sqlite:///./music_analyser.db
# Production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/musicanalyser
DATABASE_URL=sqlite:///./music_analyser.db

# --- Observability & APM (Sentry) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Cloud Storage (AWS S3) ---
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your-music-analyser-audio-bucket

# --- AI & Transcription (Groq API) ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama3-8b-8192

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# --- Spotify Metadata API ---
SPOTIPY_CLIENT_ID=your-spotify-client-id
SPOTIPY_CLIENT_SECRET=your-spotify-client-secret

# --- YouTube Audio Downloader ---
YT_COOKIES_PATH=cookies.txt

# --- Email Notifications & Password Reset (SMTP) ---
MAIL_USERNAME=your-smtp-username@gmail.com
MAIL_PASSWORD=your-smtp-app-password
MAIL_FROM=no-reply@musicanalyser.io
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- CORS Allowed Origins ---
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8080

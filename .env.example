# =================================================================
# AI Music Analyser - Environment Configuration
# =================================================================

# --- Application Server ---
APP_ENV=development
PORT=8080
DEBUG=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/music_analyser_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=music_analyser_db

# --- Security & JWT Authentication ---
SECRET_KEY=change_this_to_a_secure_random_64_char_hex_string_for_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAY=30

# --- Google OAuth 2.0 ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- AI & Transcription Services ---
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_LLM_MODEL=llama-3.1-8b-instant

# --- AWS S3 Storage ---
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_s3_bucket_name
AWS_REGION=us-east-1

# --- Spotify API Credentials ---
SPOTIPY_CLIENT_ID=your_spotify_client_id
SPOTIPY_CLIENT_SECRET=your_spotify_client_secret

# --- YouTube Download Configuration ---
YT_COOKIES_PATH=./cookies.txt

# --- Transactional Email (FastMail / SMTP) ---
MAIL_USERNAME=notifications@musicanalyser.io
MAIL_PASSWORD=your_secure_smtp_password
MAIL_FROM=notifications@musicanalyser.io
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- Frontend Application URL ---
FRONTEND_URL=http://localhost:5173
